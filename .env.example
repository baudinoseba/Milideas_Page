# ==============================================================================
# MILIDEAS PAGE — CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================
# IMPORTANTE:
# - Las variables con prefijo NEXT_PUBLIC_* se compilan y se envían al navegador.
# - Las variables SIN prefijo son SECRETAS y SOLO deben existir en el servidor.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Base de Datos, Autenticación y Storage)
# ------------------------------------------------------------------------------
# [PÚBLICO] URL de tu proyecto Supabase (HTTPS obligatorio)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# [PÚBLICO] Anon Key de Supabase (Sujeta a Row Level Security en Postgres)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# [PRIVADO / SERVER ONLY] Service Role Key (Bypassea RLS para verificaciones admin)
# ⚠️ PELIGRO: NUNCA agregar NEXT_PUBLIC_ a esta variable ni exponer en el cliente.
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. APLICACIÓN WEB & CONTACTO
# ------------------------------------------------------------------------------
# [PÚBLICO] URL base del sitio (usada para canonicals, sitemap y OAuth redirects)
# En Staging: https://staging.milideas.com
# En Producción: https://milideas.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [PÚBLICO] Datos de cuenta bancaria para pago por transferencia
NEXT_PUBLIC_BANK_ACCOUNT_INFO=CBU: 0000003100010000000000 / Alias: milideas.taller.mp

# [PÚBLICO] WhatsApp oficial de la artista / vendedora (formato internacional sin signos)
NEXT_PUBLIC_VENDOR_WHATSAPP=5493493664420

# ------------------------------------------------------------------------------
# 3. SEGURIDAD & ADMINISTRACIÓN
# ------------------------------------------------------------------------------
# [PRIVADO / SERVER ONLY] Secreto para habilitar la acción de inicialización admin
# Generar un token aleatorio seguro (ej: openssl rand -hex 32)
ADMIN_SETUP_SECRET=generate-a-secure-random-64-character-token-here

# ------------------------------------------------------------------------------
# 4. INTELIGENCIA ARTIFICIAL (Google Gemini)
# ------------------------------------------------------------------------------
# [PRIVADO / SERVER ONLY] API Key de Google AI Studio para generar descripciones
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH (Configurado en Supabase Dashboard)
# ------------------------------------------------------------------------------
# [PRIVADO] Credenciales de la consola de Google Cloud
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 6. NOTIFICACIONES POR EMAIL (Resend)
# ------------------------------------------------------------------------------
# [PRIVADO / SERVER ONLY] API Key de Resend (https://resend.com)
RESEND_API_KEY=re_...
# [PRIVADO / SERVER ONLY] Correo de la administradora/artista que recibe las notificaciones
ADMIN_NOTIFICATION_EMAIL=admin@example.com
# [PRIVADO / SERVER ONLY] Remitente configurado (ej: onboarding@resend.dev o info@tudominio.com)
EMAIL_FROM=Milideas Notificaciones <onboarding@resend.dev>
# [PRIVADO / SERVER ONLY] Secreto para proteger endpoints de Cron Jobs
CRON_SECRET=generate-a-secure-cron-secret

